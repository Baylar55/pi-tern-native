{
	"name": "pi-tern-native",
	"version": "0.1.0",
	"description": "Native Tern UI for the pi coding agent: pi draws its transcript, composer and tool cards as Tern surface widgets, the way oh-my-pi does.",
	"private": true,
	"type": "module",
	"keywords": ["pi-package", "pi", "pi-coding-agent", "tern", "tsp"],
	"pi": {
		"extensions": ["./src/index.ts"]
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "node --test test/*.test.ts",
		"shot": "bash test/shot.sh"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.5.2",
		"@earendil-works/pi-coding-agent": "^1.5.2",
		"@earendil-works/pi-tui": "^1.5.2",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0"
	}
}
